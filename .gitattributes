* text=auto
*.java text eol=lf
*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
gradlew text eol=lf
gradlew.bat text eol=crlf
*.png binary
*.jar binary
*.f32 binary

*.csv text eol=lf
*.gradle text eol=lf

# Immutable evidence hashes refer to exact bytes, including line endings.
/evidence/runs/** -text whitespace=cr-at-eol
# Instrumentation emits terminal blank lines; keep the raw output exactly.
/evidence/runs/**/instrumentation.log whitespace=cr-at-eol,-blank-at-eof
/evidence/archive/** -text whitespace=cr-at-eol

/app/src/main/assets/licenses/* -text
/evidence/releases/** -text whitespace=cr-at-eol
/evidence/research/pixel10-20261001/** -text whitespace=cr-at-eol

# Prepared source fixtures retain the byte identities used by release evidence.
/app/src/androidTest/assets/places/*.osm -text whitespace=cr-at-eol
/app/src/androidTest/assets/places/*.json -text whitespace=cr-at-eol
